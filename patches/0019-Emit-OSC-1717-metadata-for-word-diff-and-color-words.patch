diff --git a/diff-line-metadata.c b/diff-line-metadata.c
new file mode 100644
index 0000000000..020a507182
--- /dev/null
+++ b/diff-line-metadata.c
@@ -0,0 +1,109 @@
+#include "git-compat-util.h"
+#include "diff-line-metadata.h"
+#include "pager.h"
+#include "strbuf.h"
+
+/*
+ * The OSC number the protocol uses.  There is no registry to allocate one
+ * from; this one was picked because no terminal in wide use interprets it,
+ * so a terminal that is handed a record skips it as an unknown sequence
+ * rather than acting on it.
+ */
+#define METADATA_OSC "1717"
+
+/* The variable a consumer advertises itself in, named after the OSC. */
+#define METADATA_ENV "OSC1717"
+
+/* The highest protocol version we know how to emit. */
+#define METADATA_VERSION 1
+
+/*
+ * A consumer advertises the versions it understands as "V1,V2,...", and we
+ * emit the highest one both sides know.  An entry we cannot parse is
+ * skipped rather than taken as a reason to stay silent, so that a consumer
+ * which has grown a version we do not know still gets an older one.
+ */
+static int parse_advertised_versions(const char *advertised)
+{
+	int negotiated = 0;
+
+	while (*advertised) {
+		const char *end = strchrnul(advertised, ',');
+
+		if (*advertised == 'V') {
+			char *number_end;
+			long version = strtol(advertised + 1, &number_end, 10);
+
+			if (number_end == end && negotiated < version &&
+			    version <= METADATA_VERSION)
+				negotiated = version;
+		}
+
+		advertised = *end ? end + 1 : end;
+	}
+
+	return negotiated;
+}
+
+int diff_line_metadata_version(void)
+{
+	static int version = -1;
+	const char *advertised;
+
+	if (0 <= version)
+		return version;
+
+	version = 0;
+
+	advertised = getenv(METADATA_ENV);
+	if (!advertised)
+		return version;
+
+	/*
+	 * A pager between us and the consumer may be a diff renderer that
+	 * lays the diff out anew, in which case only it knows where each
+	 * line of it ends up on the screen and only its records describe
+	 * what the consumer sees.  Ours would describe bytes that nothing
+	 * shows, so leave the records to whoever renders last.
+	 */
+	if (pager_in_use())
+		return version;
+
+	version = parse_advertised_versions(advertised);
+
+	return version;
+}
+
+void diff_line_metadata_announce(FILE *file)
+{
+	static int announced;
+	int version = diff_line_metadata_version();
+
+	if (!version || announced)
+		return;
+
+	announced = 1;
+	fprintf(file, "\033]%s;%d\033\\", METADATA_OSC, version);
+}
+
+void strbuf_add_diff_line_metadata(struct strbuf *sb,
+				   const struct diff_line_metadata *meta,
+				   enum diff_line_metadata_type type,
+				   unsigned long old_lno,
+				   unsigned long new_lno)
+{
+	if (!meta->version)
+		return;
+
+	strbuf_addf(sb, "\033]%s;%d;%c;", METADATA_OSC, meta->version, type);
+	if (type != DIFF_LINE_METADATA_FILE_HEADER)
+		strbuf_addf(sb, "%lu", new_lno);
+	strbuf_addch(sb, ';');
+	if (type == DIFF_LINE_METADATA_DELETED)
+		strbuf_addf(sb, "%lu", old_lno);
+	/*
+	 * The path goes last so that it may itself contain the field
+	 * separator; everything after the fourth ";" is the path.
+	 */
+	strbuf_addf(sb, ";%s\033\\", meta->path);
+}
diff --git a/diff-line-metadata.h b/diff-line-metadata.h
new file mode 100644
index 0000000000..f7cef77c27
--- /dev/null
+++ b/diff-line-metadata.h
@@ -0,0 +1,70 @@
+#ifndef DIFF_LINE_METADATA_H
+#define DIFF_LINE_METADATA_H
+
+/*
+ * Diff line metadata: an OSC escape sequence emitted in front of each
+ * region of rendered diff output, naming the line of the diff that region
+ * stands for.  It lets a program that shows our output in a terminal view
+ * map a cell on the screen back to a line of the patch -- to stage it, to
+ * open an editor on it, or to keep the view anchored on it across a
+ * re-render.
+ *
+ * A unified diff needs no such help, as it can be read back from the
+ * output: walk up to the "@@" line and count.  A word diff cannot, as its
+ * inline "[-...-]{+...+}" markup leaves neither a marker column nor line
+ * numbers behind, so only we know what each rendered region belongs to.
+ *
+ * Nothing is emitted unless a consumer asks for it by advertising the
+ * protocol versions it understands in the OSC1717 environment
+ * variable, so output to a terminal, a pipeline or a file is unchanged.
+ *
+ * See Documentation/technical/diff-line-metadata.adoc for the protocol.
+ */
+
+struct strbuf;
+
+/*
+ * The kind of line a record describes.  A consumer that does not know a
+ * type ignores the record rather than rejecting it, so this set can grow.
+ */
+enum diff_line_metadata_type {
+	DIFF_LINE_METADATA_CONTEXT = 'c',
+	DIFF_LINE_METADATA_ADDED = 'a',
+	DIFF_LINE_METADATA_DELETED = 'd',
+	DIFF_LINE_METADATA_FILE_HEADER = 'f',
+	DIFF_LINE_METADATA_HUNK_HEADER = 'h'
+};
+
+/* What all the records of one filepair's output have in common. */
+struct diff_line_metadata {
+	int version; /* 0 when we are not emitting */
+	const char *path;
+};
+
+/*
+ * The protocol version to emit, negotiated with the consumer, or 0 if we
+ * emit nothing at all.
+ */
+int diff_line_metadata_version(void);
+
+/*
+ * Name the negotiated version, once per run and ahead of any diff, so
+ * that a consumer can learn by running us on an empty diff that we speak
+ * the protocol at all.  A no-op when we are not emitting.
+ */
+void diff_line_metadata_announce(FILE *file);
+
+/*
+ * Append the record for one region.  Which line numbers belong in it
+ * follows from the type, so that a consumer can tell a record's shape
+ * from its type alone: a file header carries neither number, a deletion
+ * carries both, everything else carries only new_lno.  A no-op when we
+ * are not emitting.
+ */
+void strbuf_add_diff_line_metadata(struct strbuf *sb,
+				   const struct diff_line_metadata *meta,
+				   enum diff_line_metadata_type type,
+				   unsigned long old_lno,
+				   unsigned long new_lno);
+
+#endif /* DIFF_LINE_METADATA_H */
