From 958dbd94536ad0d51d0331bc2f83736c8cc1ce39 Mon Sep 17 00:00:00 2001
From: Stefan Haller <stefan@haller-berlin.de>
Date: Tue, 25 Jan 2022 19:05:21 +0100
Subject: [PATCH 18/19] Skip validation of asciidoc files

This seems to sometimes fail, and since we don't care about fixing broken
documents, ignore it.
---
 Documentation/Makefile   | 2 ++
 contrib/subtree/Makefile | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/Documentation/Makefile b/Documentation/Makefile
index 671267a8ac..e1c1934e96 100644
--- a/Documentation/Makefile
+++ b/Documentation/Makefile
@@ -203,6 +203,8 @@ MAN_BASE_URL = file://$(htmldir)/
 endif
 XMLTO_EXTRA += --stringparam man.base.url.for.relative.links='$(MAN_BASE_URL)'
 
+XMLTO_EXTRA += -x manpage.xsl
+
 ifdef USE_ASCIIDOCTOR
 ASCIIDOC = asciidoctor
 ASCIIDOC_CONF =
diff --git a/contrib/subtree/Makefile b/contrib/subtree/Makefile
index c0c9f21cb7..19c7a49684 100644
--- a/contrib/subtree/Makefile
+++ b/contrib/subtree/Makefile
@@ -25,7 +25,7 @@ ASCIIDOC_DOCBOOK = docbook
 ASCIIDOC_EXTRA   =
 ASCIIDOC_DEPS    = asciidoc.conf
 XMLTO            = xmlto
-XMLTO_EXTRA      =
+XMLTO_EXTRA      = --skip-validation
 
 ifdef USE_ASCIIDOCTOR
 ASCIIDOC         = asciidoctor
-- 
2.48.1

