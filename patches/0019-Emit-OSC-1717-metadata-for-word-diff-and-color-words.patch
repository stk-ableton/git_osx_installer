+#!/bin/sh
+
+test_description='diff line metadata over OSC 1717
+
+Tests the records git puts in front of the regions of a word diff when a
+consumer advertises the protocol in the OSC1717 variable.'
+
+. ./test-lib.sh
+. "$TEST_DIRECTORY"/lib-terminal.sh
+
+ESC=$(printf '\033')
+
+# Make the records comparable: turn the "ESC ] payload ESC \" framing of
+# each one into "<payload>".  Output that holds no record is unchanged, so
+# comparing a file with its decoded self shows whether any was emitted.
+decode_records () {
+	sed -e "s/$ESC]\\([^$ESC]*\\)$ESC\\\\/<\\1>/g"
+}
+
+test_expect_success 'setup' '
+	test_write_lines one two three four five six seven >file &&
+	git add file &&
+	git commit -m initial &&
+	test_write_lines one "two modified" three "" INSERTED four seven >file
+'
+
+test_expect_success 'no records without the handshake' '
+	git diff --word-diff=plain >actual &&
+	decode_records <actual >decoded &&
+	test_cmp actual decoded
+'
+
+test_expect_success 'no records for a version we do not speak' '
+	git diff --word-diff=plain >expect &&
+	OSC1717=V2 git diff --word-diff=plain >actual &&
+	test_cmp expect actual
+'
+
+test_expect_success 'an unparsable advertisement is skipped, not fatal' '
+	OSC1717=V1 git diff --word-diff=plain >expect &&
+	OSC1717=V1,V9beta git diff --word-diff=plain >actual &&
+	test_cmp expect actual &&
+
+	OSC1717=V0,V1,V2 git diff --word-diff=plain >actual &&
+	test_cmp expect actual
+'
+
+test_expect_success 'a wholly unparsable advertisement emits nothing' '
+	git diff --word-diff=plain >expect &&
+	OSC1717=junk git diff --word-diff=plain >actual &&
+	test_cmp expect actual &&
+
+	OSC1717= git diff --word-diff=plain >actual &&
+	test_cmp expect actual
+'
+
