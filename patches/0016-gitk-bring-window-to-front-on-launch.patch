From df04e6eaa6cd623bb6ba88ab2470f89f2d96382e Mon Sep 17 00:00:00 2001
From: Stefan Haller <stefan@haller-berlin.de>
Date: Tue, 5 Nov 2024 14:16:31 +0100
Subject: [PATCH 16/18] gitk: bring window to front on launch

This fixes gitk launching in the background on macOS Sequoia.

Git-gui also calls this unconditionally on all platforms, so it can't be bad. :)
---
 gitk-git/gitk | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/gitk-git/gitk b/gitk-git/gitk
index ac68d43993..d1044b6dac 100755
--- a/gitk-git/gitk
+++ b/gitk-git/gitk
@@ -13028,9 +13028,7 @@ if {[info exists permviews]} {
     }
 }
 
-if {[tk windowingsystem] eq "win32"} {
-    focus -force .
-}
+focus -force .
 
 setttkstyle
 set_gui_colors
-- 
2.51.2

