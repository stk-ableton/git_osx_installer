+/*
+ * Write out a block of header rows, naming the file in front of each of
+ * them.  Every row is named, not just the one we might call the block's
+ * first, so that a consumer can act wherever the user points within a
+ * header; and a file with no content rows at all -- a mode change, a
+ * rename, a binary file -- is named at least this once.
+ */
+static void emit_file_header(struct diff_options *o,
+			     const struct diff_line_metadata *meta,
+			     const char *line, int len)
+{
+	const char *prefix = diff_line_prefix(o);
+	size_t prefix_len = strlen(prefix);
+	const char *p = line, *end = line + len;
+	struct strbuf out = STRBUF_INIT;
+
+	if (!meta->version) {
+		fprintf(o->file, "%s", line);
+		return;
+	}
+
+	while (p < end) {
+		const char *nl = memchr(p, '\n', end - p);
+		size_t row = nl ? (size_t)(nl - p) + 1 : (size_t)(end - p);
+
+		/*
+		 * Past the prefix the row already starts with, so that the
+		 * record lands in front of the text rather than inside the
+		 * graph drawn to the left of it.
+		 */
+		if (prefix_len && row >= prefix_len &&
+		    !memcmp(p, prefix, prefix_len)) {
+			strbuf_add(&out, p, prefix_len);
+			p += prefix_len;
+			row -= prefix_len;
+		}
+		strbuf_add_diff_line_metadata(&out, meta,
+					      DIFF_LINE_METADATA_FILE_HEADER,
+					      0, 0);
+		strbuf_add(&out, p, row);
+		p += row;
+	}
+
+	fprintf(o->file, "%s", out.buf);
+	strbuf_release(&out);
+}
+
